.day {
  padding: 24rpx 32rpx 8rpx;
}

.day-head {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border);
}

.day-total {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
}

.card {
  background: var(--surface);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.bold {
  font-weight: 600;
}

.muted {
  color: var(--text-muted);
}

.small {
  font-size: 24rpx;
}

.num {
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  padding: 72rpx 0;
  color: var(--text-muted);
}

.empty-icon {
  width: 144rpx;
  height: 144rpx;
  line-height: 144rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  font-size: 68rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--text-muted);
  font-size: 24rpx;
}
