.day {
  padding: 20rpx 32rpx 8rpx;
}

.day-head {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.card {
  background: var(--surface);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.bold {
  font-weight: 600;
}

.muted {
  color: var(--text-muted);
}

.small {
  font-size: 24rpx;
}

.num {
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--text-muted);
  font-size: 24rpx;
}
