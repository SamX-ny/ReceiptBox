.receipt-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.hover {
  opacity: 0.7;
}

.icon-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.body {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.branch {
  font-weight: 400;
  color: var(--text-muted);
  font-size: 25rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.right {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.cat {
  display: inline-block;
  font-size: 21rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: var(--surface-2);
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
