.receipt-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.hover {
  opacity: 0.7;
}

.icon-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.body {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.branch {
  font-weight: 400;
  color: var(--text-muted);
  font-size: 26rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.right {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.cat {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
