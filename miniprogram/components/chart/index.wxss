.chart {
  position: relative;
  width: 100%;
}

.canvas {
  width: 100%;
  height: 100%;
}

.empty-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 40%;
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

.tip {
  position: absolute;
  transform: translate(-50%, -100%);
  background: var(--text-primary);
  color: var(--surface);
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
  pointer-events: none;
  z-index: 2;
}

.tip-title {
  opacity: 0.8;
}

.tip-value {
  font-size: 26rpx;
  font-weight: 600;
}

.tip-sub {
  opacity: 0.8;
}
