.profile {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 44rpx 36rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: var(--hero);
  color: #ffffff;
  box-shadow: var(--shadow-brand);
}

.profile-deco {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  right: -100rpx;
  top: -140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  margin-right: 28rpx;
}

.big {
  font-size: 36rpx;
}

.profile-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

.profile-arrow {
  font-size: 40rpx;
  opacity: 0.8;
}

.members {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.member {
  width: 120rpx;
  text-align: center;
  margin: 0 12rpx 16rpx 0;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 8rpx;
  border-radius: 40rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.member-name {
  color: var(--text-secondary);
}

.invite {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-soft);
  border: 2rpx dashed var(--brand);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.links {
  margin-top: 16rpx;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-top: 1rpx solid var(--border);
}

.danger {
  color: var(--bad);
}

.cats {
  display: flex;
  flex-wrap: wrap;
}

.cat {
  width: 25%;
  text-align: center;
  padding: 12rpx 0;
  color: var(--text-secondary);
}

.cat-icon {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0 auto 8rpx;
  border-radius: 26rpx;
  font-size: 42rpx;
}

.about view + view {
  margin-top: 4rpx;
}
