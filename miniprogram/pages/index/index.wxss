.hero {
  padding: 36rpx 32rpx;
}

.hero-label {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.hero-amount {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin: 8rpx 0;
}

.hero-sub {
  color: var(--text-secondary);
}

.hero-stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.hero-stat {
  flex: 1;
}

.actions {
  display: flex;
  margin-bottom: 24rpx;
}

.scan-btn {
  flex: 1.4;
  height: 112rpx;
  border-radius: 28rpx;
  font-size: 34rpx;
  margin: 0 16rpx 0 0;
}

.action-secondary {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.action-secondary .btn {
  height: 52rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: var(--surface);
  margin: 0;
  width: 100%;
}

.action-secondary .btn + .btn {
  margin-top: 8rpx;
}

/* ===== 待确认小票 ===== */
.scan {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.scan:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.scan-main {
  display: flex;
  align-items: center;
}

.scan-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.scan-title {
  font-size: 30rpx;
  font-weight: 500;
}

.scan-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.scan-dup {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: var(--warn-bg);
  color: var(--warn-text);
  font-size: 22rpx;
}

.scan.failed .scan-title {
  color: var(--bad);
}

.scan.failed .scan-sub {
  color: var(--text-secondary);
  word-break: break-all;
}

.scan-go {
  color: var(--brand);
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.scan-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.scan-btn {
  padding: 8rpx 24rpx;
  margin-left: 16rpx;
  border-radius: 24rpx;
  background: var(--surface-2);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.scan-btn.primary {
  background: var(--brand);
  color: var(--brand-text);
}

.scan-btn.danger {
  color: var(--bad);
}

.spinner {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--brand);
  border-radius: 50%;
  vertical-align: -2rpx;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
