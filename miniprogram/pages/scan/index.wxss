.preview {
  position: relative;
  padding: 0;
  overflow: hidden;
  height: 720rpx;
  background: var(--surface-2);
}

.photo {
  width: 100%;
  height: 100%;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--brand);
  box-shadow: 0 0 24rpx var(--brand);
  animation: scan 2.2s ease-in-out infinite;
}

@keyframes scan {
  0% { top: 4%; }
  50% { top: 94%; }
  100% { top: 4%; }
}

.step {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  color: var(--text-muted);
}

.step.doing,
.step.done {
  color: var(--text-primary);
}

.dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 22rpx;
  background: var(--surface-2);
  font-size: 22rpx;
  margin-right: 20rpx;
}

.step.done .dot,
.step.doing .dot {
  background: var(--brand);
  color: var(--brand-text);
}

.hint {
  margin-top: 12rpx;
}

.error-card {
  border: 2rpx solid var(--bad);
}
