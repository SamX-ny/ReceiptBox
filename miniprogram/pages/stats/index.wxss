.summary .big {
  font-size: 64rpx;
  font-weight: 700;
  margin: 4rpx 0;
}

.kpis {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.kpi {
  flex: 1;
}

.rank-row {
  padding: 16rpx 0;
}

.day-receipt {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.day-receipt:last-child {
  border-bottom: none;
}

.day-item {
  padding: 8rpx 0 0 8rpx;
}

.day-item-icon {
  width: 44rpx;
}

.cat-label {
  margin: 0 16rpx;
}
