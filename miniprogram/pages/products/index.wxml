<view class="container">
  <view wx:if="{{mergeFrom}}" class="warn-banner">选择与「{{mergeName}}」是同一种商品的条目，合并后可以一起比较价格。</view>

  <view class="search">
    <image class="search-icon" src="/images/icons/search-gray.png" />
    <input class="search-input" placeholder="搜索商品，如 可乐、milk" value="{{keyword}}" confirm-type="search" bindinput="onSearchInput" />
    <text wx:if="{{keyword}}" class="clear" bindtap="onSearchClear">✕</text>
  </view>

  <view class="segmented">
    <view wx:for="{{sorts}}" wx:key="id" class="seg {{sort === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onSort">{{item.name}}</view>
  </view>

  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}" style="margin-top: 20rpx">
    <view wx:for="{{chips}}" wx:key="id" class="chip {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onChip">{{item.label}}</view>
  </scroll-view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="key" class="product card" data-key="{{item.key}}" data-name="{{item.name}}" bindtap="onTap" hover-class="btn-hover">
      <view class="row">
        <view class="icon-badge" style="background: {{item.tint}}">{{item.icon}}</view>
        <view class="flex-1">
          <view class="name ellipsis">{{item.name}}<text wx:if="{{item.spec}}" class="tag spec">{{item.spec}}</text></view>
          <view class="muted tiny ellipsis">{{item.lastWhere}}</view>
        </view>
        <view class="price-col">
          <view class="price num">{{item.lastPrice}}</view>
          <view wx:if="{{item.measure}}" class="muted tiny num">{{item.measure}}</view>
        </view>
      </view>
      <view class="foot row tiny">
        <text class="tag">买过 {{item.count}} 次</text>
        <text class="tag">{{item.storeCount}} 家店</text>
        <text wx:if="{{item.range}}" class="flex-1 range num muted">{{item.range}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loaded && !list.length}}" class="empty">
    <view class="empty-icon">🏷️</view>
    <view>{{keyword || category ? '没有匹配的商品' : '保存带商品明细的小票后，这里会记录每样商品的价格'}}</view>
  </view>
  <view wx:if="{{list.length}}" class="load-more">{{loading ? '加载中…' : hasMore ? '上拉加载更多' : '没有更多了'}}</view>
</view>
